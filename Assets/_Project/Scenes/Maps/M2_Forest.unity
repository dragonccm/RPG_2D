  m_Script: {fileID: 11500000, guid: fad38d4805cb05103b250919b346f187, type: 3}
  m_Name: 
  m_EditorClassIdentifier: RPG.Game::DialogueInteractable
  firstMeet:
    blockId: na_first
    lines:
    - speaker: "B\xE9 Na"
      text: "Anh Ki\u1EC1n! Em... em ch\u1EA1y theo con c\u1EEBu r\u1ED3i l\u1EA1c m\u1EA5t \u0111\u01B0\u1EDDng v\u1EC1."
    - speaker: "B\xE9 Na"
      text: "Ch\u1ECB Lam ng\xE0y x\u01B0a hay d\u1EABn em ra \u0111\xE2y h\xE1t b\xE0i c\xFAng tr\u0103ng. Ch\u1ECB b\u1EA3o tr\u0103ng tr\u1EAFng l\xE0 tr\u0103ng hi\u1EC1n."
    - speaker: "B\xE9 Na"
      text: "C\u1EA7m c\xE1i n\xE0y \u0111i \u2014 m\u1EB9 d\u1EB7n em \u0111\u01B0a cho ng\u01B0\u1EDDi canh l\xE0ng."
    startQuestOnEnd: 
    reportObjectiveOnEnd: 
    claimQuestOnEnd: 
    giveItemOnEnd: potion_hp
    setFlagOnEnd: npc:na_met
  questBlock:
    blockId: 
    lines: []
    startQuestOnEnd: 
    reportObjectiveOnEnd: 
    claimQuestOnEnd: 
    giveItemOnEnd: 
    setFlagOnEnd: 
  repeat:
    blockId: na_repeat
    lines:
    - speaker: "B\xE9 Na"
      text: "Em s\u1EBD ch\u1EDD \u1EDF \u0111\xE2y t\u1EDBi khi anh d\u1ECDn \u0111\u01B0\u1EDDng. \u0110\u1EEBng \u0111\u1EC3 b\u1ECDn m\u1EAFt \u0111\u1ECF l\u1EA1i g\u1EA7n nh\xE9..."
    startQuestOnEnd: 
    reportObjectiveOnEnd: 
    claimQuestOnEnd: 
    giveItemOnEnd: 
    setFlagOnEnd: 
  rewardBlock:
    blockId: 
    lines: []
    startQuestOnEnd: 
    reportObjectiveOnEnd: 
    claimQuestOnEnd: 
    giveItemOnEnd: 
    setFlagOnEnd: 
  rewardAfterQuest: 
