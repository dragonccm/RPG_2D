    lines:
    - speaker: "B\xE9 Na"
      text: "Em s\u1EBD ch\u1EDD \u1EDF \u0111\xE2y t\u1EDBi khi anh d\u1ECDn \u0111\u01B0\u1EDDng. \u0110\u1EEBng \u0111\u1EC3 b\u1ECDn m\u1EAFt \u0111\u1ECF l\u1EA1i g\u1EA7n nh\xE9..."
    startQuestOnEnd: 
    reportObjectiveOnEnd: 
    claimQuestOnEnd: 
