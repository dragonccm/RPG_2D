--- !u!114 &1066236641
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1066236639}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fad38d4805cb05103b250919b346f187, type: 3}
  m_Name: 
  m_EditorClassIdentifier: RPG.Game::DialogueInteractable
  firstMeet:
    blockId: mai_first
    lines:
    - speaker: Mai
      text: "Ki\u1EC1n... tr\u0103ng h\xF4m nay \u0111\u1ECF l\u1EAFm. \xD4ng v\u1EABn nh\u1EDB 3 n\u0103m tr\u01B0\u1EDBc ch\u1EE9?"
    - speaker: "Ki\u1EC1n"
      text: "Nh\u1EDB. Nghi th\u1EE9c b\u1ECB b\u1ECF d\u1EDF \u2014 v\xE0 nh\u1EEFng g\xEC \u1EDF ngo\xE0i r\u1EEBng \u0111\xEAm qua kh\xF4ng ph\u1EA3i s\xF3i th\u01B0\u1EDDng."
    - speaker: Mai
      text: "Ra g\u1EB7p \xD4ng T\u1EC5 tr\u01B0\u1EDBc \u0111i. R\u1ED3i... con quy\u1EBFt \u0111\u1ECBnh. L\xE0ng n\xE0y kh\xF4ng \u0111\u1EE3i n\u1ED5i m\u1ED9t ai kh\xE1c."
    startQuestOnEnd: q1
    reportObjectiveOnEnd: 
    claimQuestOnEnd: 
    giveItemOnEnd: 
    setFlagOnEnd: 
  questBlock:
    blockId: 
    lines: []
    startQuestOnEnd: 
    reportObjectiveOnEnd: 
    claimQuestOnEnd: 
    giveItemOnEnd: 
    setFlagOnEnd: 
  repeat:
    blockId: mai_repeat
    lines:
    - speaker: Mai
      text: "\xD4ng T\u1EC5 \u1EDF \u0111\u1EA7u l\xE0ng. \u0110\u1EEBng \u0111\u1EC3 \xF4ng ch\u1EDD l\xE2u \u2014 \xF4ng gi\xE0 r\u1ED3i nh\u01B0ng v\u1EABn c\xE0u nh\xE0u l\u1EAFm."
    startQuestOnEnd: 
    reportObjectiveOnEnd: 
    claimQuestOnEnd: 
    giveItemOnEnd: 
    setFlagOnEnd: 
  rewardBlock:
    blockId: mai_reward
    lines:
    - speaker: Mai
      text: "\xD4ng T\u1EC5 b\u1EA3o tay ki\u1EBFm con \u0111\xE3 v\u1EEFng. C\u1EA7m l\u1EA5y \u2014 cu\u1ED9n n\xE0y l\xE0 c\u1EE7a cha con \u0111\u1EC3 l\u1EA1i."
    - speaker: Mai
      text: "L\u01B0\u1EDBt Gi\xF3: ch\u1EA1y nh\u01B0 gi\xF3 qua khe n\u01B0\u1EDBc, qua h\u1ED1 \u0111\u1EA5t. Kh\xF4ng c\xF3 n\xF3, r\u1EEBng s\u1EBD nu\u1ED1t con."
    - speaker: "Ki\u1EC1n"
      text: "C\u1ED5ng b\u1EAFc...?"
    - speaker: Mai
      text: "Ta \u0111\xE3 cho m\u1EDF. \u0110i \u0111i \u2014 tr\u01B0\u1EDBc khi tr\u0103ng l\xEAn t\u1EDBi \u0111\u1EC9nh."
    startQuestOnEnd: 
    reportObjectiveOnEnd: 
    claimQuestOnEnd: 
    giveItemOnEnd: scroll_dash
    setFlagOnEnd: gate:village_north
  rewardAfterQuest: q1
  interactRange: 1.6
  interactKey: 102
