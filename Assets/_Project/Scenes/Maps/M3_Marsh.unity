  m_Script: {fileID: 11500000, guid: fad38d4805cb05103b250919b346f187, type: 3}
  m_Name: 
  m_EditorClassIdentifier: RPG.Game::DialogueInteractable
  firstMeet:
    blockId: laocau_first
    lines:
    - speaker: "L\xE3o C\xE2u"
      text: "H\u1EEBm, ng\u01B0\u1EDDi l\xE0ng Phong Nguy\u1EC7t h\u1EA3? \u0110\u1EA7m n\xE0y ba n\u0103m nay kh\xF4ng ai d\xE1m qua."
    - speaker: "L\xE3o C\xE2u"
      text: "B\u1ECDn m\u1EB7c \xE1o c\xFAng \u0111\xF3ng tr\u1EA1i tr\xEAn \u0111\u1EA3o gi\u1EEFa \u0111\u1EA7m. Ch\xFAng gi\u1EEF Ch\xECa Kh\xF3a Th\xE1p."
    - speaker: "L\xE3o C\xE2u"
      text: "H\u1EA1 \u0111\u01B0\u1EE3c k\u1EBB c\u1EA7m \u0111\u1EA7u th\xEC quay l\u1EA1i \u0111\xE2y \u2014 l\xE3o ch\u1EDF ng\u01B0\u01A1i v\u1EC1 l\xE0ng b\u1EB1ng \u0111\xF2."
    startQuestOnEnd: 
    reportObjectiveOnEnd: 
    claimQuestOnEnd: 
    giveItemOnEnd: 
    setFlagOnEnd: npc:laocau_met
  questBlock:
    blockId: 
    lines: []
    startQuestOnEnd: 
    reportObjectiveOnEnd: 
    claimQuestOnEnd: 
    giveItemOnEnd: 
    setFlagOnEnd: 
  repeat:
    blockId: laocau_repeat
    lines:
    - speaker: "L\xE3o C\xE2u"
      text: "B\xF9n \u1EDF ph\xEDa b\u1EAFc s\xE2u l\u1EAFm. \u0110i ch\u1EADm th\xEC ch\u1EBFt, \u0111i nhanh th\xEC... l\u01B0\u1EDBt qua."
    startQuestOnEnd: 
    reportObjectiveOnEnd: 
    claimQuestOnEnd: 
    giveItemOnEnd: 
    setFlagOnEnd: 
  rewardBlock:
    blockId: 
    lines: []
    startQuestOnEnd: 
    reportObjectiveOnEnd: 
    claimQuestOnEnd: 
    giveItemOnEnd: 
    setFlagOnEnd: 
  rewardAfterQuest: 
  interactRange: 1.6
  interactKey: 102
