  },
  {
   "key": "menu.music",
   "text": "Nhạc nền"
  },
  {
   "key": "dlg.agis_ending_destroy.0.text",
   "text": "Ác mộng của ông... chấm dứt tại đây."
  },
  {
   "key": "dlg.agis_ending_destroy.1.text",
   "text": "Vầng trăng vỡ tan rồi... Nhưng ký ức này... ngươi sẽ phải mang theo suốt đời..."
  },
  {
   "key": "dlg.agis_ending_forgive.0.text",
   "text": "Ta... ta đã lạc lối sao? Lam... con vẫn ở đây ư?"
  },
  {
   "key": "dlg.agis_ending_forgive.1.text",
   "text": "Hãy nắm lấy tay con bé. Làng Phong Nguyệt vẫn luôn mở rộng cửa đón ông trở về."
  },
  {
   "key": "dlg.agis_ending_forgive.2.text",
   "text": "Cảm ơn ngươi... Vầng trăng đỏ... cuối cùng cũng đã tắt."
  },
  {
   "key": "dlg.agis_pre_boss.0.text",
   "text": "Ngươi cũng đến cướp vầng trăng à? Được... Nhưng trăng đêm nay là của con gái ta!"
  },
  {
   "key": "dlg.agis_pre_boss.1.text",
   "text": "Tôi đến để đưa ông và con bé trở về làng — chứ không phải để cướp nó."
  },
  {
   "key": "dlg.agis_pre_boss.2.text",
   "text": "Đã quá muộn rồi... Sức mạnh của Trăng Đỏ không thể đảo ngược!"
  },
  {
   "key": "dlg.altar_forest.0.text",
   "text": "\"Ba ngọn lửa canh ba phía. Thắp cùng lúc, đá sẽ nhường đường.\""
  },
  {
   "key": "dlg.cave_mural_left.0.text",
   "text": "Một vòng người áo trắng quỳ quanh tháp. Trăng trắng treo giữa trời. Một cô bé cầm mặt nạ đứng giữa."
  },
  {
   "key": "dlg.cave_mural_left.1.text",
   "text": "Lam... đây là lễ cúng trăng ba năm trước."
  },
  {
   "key": "dlg.cave_mural_right.0.text",
   "text": "Phía sau cô bé có một bóng đen không mặt, tay đặt lên vai. Agis đứng cách đó rất xa, quay lưng."
  },
  {
   "key": "dlg.cave_mural_right.1.text",
   "text": "Không phải Agis... vậy ai đã dẫn Lam đi?"
  },
  {
   "key": "dlg.laocau_first.0.text",
   "text": "Hừm, người làng Phong Nguyệt hả? Đầm này ba năm nay không ai dám qua."
  },
  {
   "key": "dlg.laocau_first.1.text",
   "text": "Bọn mặc áo cúng đóng trại trên đảo giữa đầm. Chúng giữ Chìa Khóa Tháp."
  },
  {
   "key": "dlg.laocau_first.2.text",
   "text": "Hạ được kẻ cầm đầu thì quay lại đây — lão chở ngươi về làng bằng đò."
  },
  {
   "key": "dlg.laocau_repeat.0.text",
   "text": "Bùn ở phía bắc sâu lắm. Đi chậm thì chết, đi nhanh thì... lướt qua."
  },
  {
   "key": "dlg.mai_after.0.text",
   "text": "Nhớ: chỗ nào có lửa ấm thì trăng đỏ yếu đi. Nghỉ ở đống lửa khi cần."
  },
  {
   "key": "dlg.mai_first.0.text",
   "text": "Kiền... trăng hôm nay đỏ lắm. Ông vẫn nhớ 3 năm trước chứ?"
  },
  {
   "key": "dlg.mai_first.1.text",
   "text": "Nhớ. Nghi thức bị bỏ dở — và những gì ở ngoài rừng đêm qua không phải sói thường."
  },
  {
   "key": "dlg.mai_first.2.text",
   "text": "Ra gặp Ông Tễ trước đi. Rồi... con quyết định. Làng này không đợi nổi một ai khác."
  },
  {
   "key": "dlg.mai_repeat.0.text",
   "text": "Ông Tễ ở đầu làng. Đừng để ông chờ lâu — ông già rồi nhưng vẫn càu nhàu lắm."
  },
  {
   "key": "dlg.mai_reward.0.text",
   "text": "Ông Tễ bảo tay kiếm con đã vững. Cầm lấy — cuộn này là của cha con để lại."
  },
  {
   "key": "dlg.mai_reward.1.text",
   "text": "Lướt Gió: chạy như gió qua khe nước, qua hố đất. Không có nó, rừng sẽ nuốt con."
  },
  {
   "key": "dlg.mai_reward.2.text",
   "text": "Cổng bắc...?"
  },
  {
   "key": "dlg.mai_reward.3.text",
   "text": "Ta đã cho mở. Đi đi — trước khi trăng lên tới đỉnh."
  },
  {
   "key": "dlg.na_first.0.text",
   "text": "Anh Kiền! Em... em chạy theo con cừu rồi lạc mất đường về."
  },
  {
   "key": "dlg.na_first.1.text",
   "text": "Chị Lam ngày xưa hay dẫn em ra đây hát bài cúng trăng. Chị bảo trăng trắng là trăng hiền."
  },
  {
   "key": "dlg.na_first.2.text",
   "text": "Cầm cái này đi — mẹ dặn em đưa cho người canh làng."
  },
  {
   "key": "dlg.na_repeat.0.text",
   "text": "Em sẽ chờ ở đây tới khi anh dọn đường. Đừng để bọn mắt đỏ lại gần nhé..."
  },
  {
   "key": "dlg.ongte_quest.0.text",
   "text": "Ồ, Kiền đấy à. Vũ khí của ngươi đã sẵn sàng — ta vừa mài lại lưỡi đêm qua."
  },
  {
   "key": "dlg.ongte_quest.1.text",
   "text": "Đi thử một lượt combo trên sân cho chắc tay. Rồi theo dấu mà vào rừng."
  },
  {
   "key": "dlg.ongte_repeat.0.text",
   "text": "Rừng Thảm Vàng đêm nay đỏ rực. Cẩn thận — bóng ở đó không phải bóng người."
  },
  {
   "key": "dlg.sign_north.0.text",
   "text": "↑ Rừng Thảm Vàng. Cổng đóng từ khi trăng đỏ mọc — theo lệnh trưởng làng Mai."
  },
